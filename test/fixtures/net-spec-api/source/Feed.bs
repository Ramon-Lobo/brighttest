' Tiny API client under test: one synchronous GET / POST per call.
function fetchText(url as string) as string
  x = CreateObject("roUrlTransfer")
  x.setUrl(url)
  return x.getToString()
end function

sub postText(url as string, body as string)
  x = CreateObject("roUrlTransfer")
  x.setUrl(url)
  x.postFromString(body)
end sub
