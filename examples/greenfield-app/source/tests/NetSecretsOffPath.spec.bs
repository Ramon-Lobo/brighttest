namespace tests
  ' The off path of Config_applyNetSecrets. Each case builds its own fresh node, so nothing depends on m.global or on
  ' which suites ran earlier (other suites may already have added btNetSecrets to m.global), and nothing global is
  ' changed.
  @suite("Net-secrets launch param off path")
  @SGNode("HttpTask")
  class NetSecretsOffPathTests extends rooibos.BaseTestSuite

    @describe("Config_applyNetSecrets adds nothing")

    @it("when netsecrets is absent")
    function _()
      node = createObject("roSGNode", "Node")
      Config_applyNetSecrets(node, {})
      m.assertFalse(node.hasField("btNetSecrets"))
    end function

    @it("when netsecrets is disabled")
    function _()
      node = createObject("roSGNode", "Node")
      Config_applyNetSecrets(node, { netsecrets: "0" })
      m.assertFalse(node.hasField("btNetSecrets"))
    end function

    @it("when netsecrets has an invalid value")
    function _()
      for each value in ["true", "yes", "", "2", " 1"]
        node = createObject("roSGNode", "Node")
        Config_applyNetSecrets(node, { netsecrets: value })
        m.assertFalse(node.hasField("btNetSecrets"), "value '" + value + "'")
      end for
    end function

    @it("when netsecrets is not a string")
    function _()
      node = createObject("roSGNode", "Node")
      Config_applyNetSecrets(node, { netsecrets: 1 })
      m.assertFalse(node.hasField("btNetSecrets"))
    end function

    @it("when args is invalid or not an associative array")
    function _()
      node = createObject("roSGNode", "Node")
      Config_applyNetSecrets(node, invalid)
      Config_applyNetSecrets(node, "netsecrets=1")
      Config_applyNetSecrets(node, [])
      m.assertFalse(node.hasField("btNetSecrets"))
    end function

  end class
end namespace
