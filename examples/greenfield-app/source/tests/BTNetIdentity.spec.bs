namespace tests
  ' Sketch of the BTNet_* spec API (docs/writing-tests/http-fixtures.md). Kept @ignore'd: this app does not make these
  ' calls through a rewritten setUrl yet. The tag marks it for pack runs; call BTNet_reset() in @beforeEach when enabling.
  @ignore
  @tags("needs-n1")
  @suite("BTNetIdentity")
  class BTNetIdentityTests extends rooibos.BaseTestSuite
    @describe("identity")
    @it("serves a mocked /home to the hero request")
    function _()
      BTNet_mock({ method: "GET", url: "**/home", json: { title: "Mocked hero" } })
    end function
  end class
end namespace
