namespace tests
  ' Placeholder for the BTNet_* spec API. Ignored until it exists (the CLI has no tag selector yet, so
  ' @ignore does the skipping; the tag marks it for pack runs). Remove @ignore when N1 lands.
  @ignore
  @tags("needs-n1")
  @suite("BTNetIdentity")
  class BTNetIdentityTests extends rooibos.BaseTestSuite
    @describe("identity")
    @it("serves a mocked /home to the hero request")
    function _()
      BTNet_mock("GET", "/home", { title: "Mocked hero" })
    end function
  end class
end namespace
