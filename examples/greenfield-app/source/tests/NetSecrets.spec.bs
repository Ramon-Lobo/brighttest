namespace tests
  @suite("Net-secrets probe config (pure)")
  class NetSecretsTests extends rooibos.BaseTestSuite

    @describe("Config_isNetSecrets")

    @it("is on only for netsecrets=1")
    function _()
      m.assertTrue(Config_isNetSecrets({ netsecrets: "1" }))
    end function

    @it("is off by default and for other values")
    function _()
      m.assertFalse(Config_isNetSecrets({}))
      m.assertFalse(Config_isNetSecrets({ netsecrets: "0" }))
      m.assertFalse(Config_isNetSecrets({ netsecrets: "true" }))
      m.assertFalse(Config_isNetSecrets(invalid))
    end function

    @describe("Config_netSecretsRequest")

    @it("carries dummy values in the query and the Authorization header")
    function _()
      req = Config_netSecretsRequest()
      m.assertEqual(req.path, "/echo?token=abc&access_token=def&sig=ghi")
      m.assertEqual(req.headers.Authorization, "Bearer test-not-secret")
    end function

    @it("has no body")
    function _()
      m.assertInvalid(Config_netSecretsRequest().body)
    end function
  end class
end namespace
