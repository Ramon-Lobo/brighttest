namespace tests
  ' Placeholder for the BTNet_* spec API. Ignored until it exists (the CLI has no tag selector yet, so
  ' @ignore does the skipping; the tag marks it for pack runs). Remove @ignore when N1 lands.
  @ignore
  @tags("needs-n1")
  @suite("BTNetRecord")
  class BTNetRecordTests extends rooibos.BaseTestSuite
    @describe("record")
    @it("records one POST /track")
    function _()
      m.assertTrue(BTNet_recorded("POST", "/track") <> invalid)
    end function
  end class
end namespace
