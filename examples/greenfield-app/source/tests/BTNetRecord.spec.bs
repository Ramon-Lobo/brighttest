namespace tests
  ' Sketch of the BTNet_* spec API (docs/writing-tests/http-fixtures.md). Kept @ignore'd: this app does not make these
  ' calls through a rewritten setUrl yet. The tag marks it for pack runs; call BTNet_reset() in @beforeEach when enabling.
  @ignore
  @tags("needs-n1")
  @suite("BTNetRecord")
  class BTNetRecordTests extends rooibos.BaseTestSuite
    @describe("record")
    @it("records one POST /track")
    function _()
      m.assertTrue(BTNet_requests({ method: "POST", url: "**/track" }).count() > 0)
    end function
  end class
end namespace
