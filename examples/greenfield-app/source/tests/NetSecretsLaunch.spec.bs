namespace tests
  ' The launch path: Main() hands screen.getGlobalNode() to Config_applyNetSecrets before scene.ready.
  @suite("Net-secrets launch param on a node")
  @SGNode("HttpTask")
  class NetSecretsLaunchTests extends rooibos.BaseTestSuite

    @describe("Config_applyNetSecrets")

    @it("netsecrets=1 adds btNetSecrets as true")
    function _()
      Config_applyNetSecrets(m.global, { netsecrets: "1" })
      m.assertTrue(m.global.hasField("btNetSecrets"))
      m.assertTrue(m.global.btNetSecrets)
    end function

  end class
end namespace
