namespace tests
  ' Sketch of the BTNet_* spec API (docs/writing-tests/http-fixtures.md). Kept @ignore'd: this app does not make these
  ' calls through a rewritten setUrl yet. The tag marks it for pack runs; call BTNet_reset() in @beforeEach when enabling.
  @ignore
  @tags("needs-n1")
  @suite("BTNetFaults")
  class BTNetFaultsTests extends rooibos.BaseTestSuite
    @describe("faults")
    @it("turns /search into a 503")
    function _()
      BTNet_fault({ method: "GET", url: "**/search", kind: "status", status: 503 })
    end function
  end class
end namespace
