namespace tests
  ' Placeholder for the BTNet_* spec API. Ignored until it exists (the CLI has no tag selector yet, so
  ' @ignore does the skipping; the tag marks it for pack runs). Remove @ignore when N1 lands.
  @ignore
  @tags("needs-n1")
  @suite("BTNetFaults")
  class BTNetFaultsTests extends rooibos.BaseTestSuite
    @describe("faults")
    @it("turns /search into a 503")
    function _()
      BTNet_fault("GET", "/search", 503)
    end function
  end class
end namespace
